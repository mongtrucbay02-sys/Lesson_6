@model SinhVien
@{
    ViewData["Title"] = "Chi tiết sinh viên";
}

<h3 class="mb-3">Chi tiết sinh viên</h3>
<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.MaSV)</dt>
            <dd class="col-sm-9">@Model.MaSV</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.HoTen)</dt>
            <dd class="col-sm-9">@Model.HoTen</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.NgaySinh)</dt>
            <dd class="col-sm-9">@Model.NgaySinh.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.GioiTinh)</dt>
            <dd class="col-sm-9">@Model.GioiTinh</dd>
            <dt class="col-sm-3">Khoa</dt>
            <dd class="col-sm-9">@Model.Khoa?.TenKhoa</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.SoDienThoai)</dt>
            <dd class="col-sm-9">@Model.SoDienThoai</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DiaChi)</dt>
            <dd class="col-sm-9">@Model.DiaChi</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a>
    <a class="btn btn-secondary" asp-action="Index">Quay lại</a>
</div>
