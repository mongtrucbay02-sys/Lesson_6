@model SinhVien
@{
    ViewData["Title"] = "Xóa sinh viên";
}

<h3 class="mb-3 text-danger">Xác nhận xóa sinh viên?</h3>
<div class="card shadow-sm border-danger">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Mã SV</dt>
            <dd class="col-sm-9">@Model.MaSV</dd>
            <dt class="col-sm-3">Họ và tên</dt>
            <dd class="col-sm-9">@Model.HoTen</dd>
            <dt class="col-sm-3">Ngày sinh</dt>
            <dd class="col-sm-9">@Model.NgaySinh.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Khoa</dt>
            <dd class="col-sm-9">@Model.Khoa?.TenKhoa</dd>
        </dl>
    </div>
</div>
<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" name="id" value="@Model.Id" />
    <button class="btn btn-danger">Xóa</button>
    <a class="btn btn-secondary" asp-action="Index">Hủy</a>
</form>