@model List<SinhVien>
@{
    ViewData["Title"] = "Danh sách sinh viên";
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Danh sách sinh viên <small class="text-muted fs-6">(@ViewBag.Total kết quả)</small></h3>
    <a class="btn btn-success" asp-action="Create">+ Thêm sinh viên</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo mã SV hoặc họ tên..." />
    </div>
    <div class="col-md-4">
        <select name="khoaId" class="form-select" asp-items="(SelectList)ViewBag.Khoas">
            <option value="">-- Tất cả khoa --</option>
        </select>
    </div>
    <div class="col-md-3">
        <button class="btn btn-primary">Tìm kiếm</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Đặt lại</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã SV</th>
                    <th>Họ và tên</th>
                    <th>Ngày sinh</th>
                    <th>Giới tính</th>
                    <th>Khoa</th>
                    <th>Email</th>
                    <th>Hình ảnh</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sv in Model)
                {
                    <tr>
                        <td>@sv.MaSV</td>
                        <td>@sv.HoTen</td>
                        <td>@sv.NgaySinh.ToString("dd/MM/yyyy")</td>
                        <td>@sv.GioiTinh</td>
                        <td>@sv.Khoa?.TenKhoa</td>
                        <td>@sv.Email</td>
                        <td>
                            @if (sv.Anhs.Any())
                            {
                                <div class="d-flex align-items-center gap-1">
                                    @foreach (var anh in sv.Anhs.Take(3))
                                    {
                                        <img src="@anh.DuongDan" alt="@sv.HoTen" class="rounded" style="width:48px;height:48px;object-fit:cover" loading="lazy" />
                                    }
                                    @if (sv.Anhs.Count > 3)
                                    {
                                        <span class="badge bg-secondary">+@(sv.Anhs.Count - 3)</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@sv.Id">Chi tiết</a>
                            <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@sv.Id">Sửa</a>
                            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@sv.Id">Xóa</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Không có dữ liệu</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(page - 1)" asp-route-search="@ViewBag.Search" asp-route-khoaId="@ViewBag.KhoaId">«</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-khoaId="@ViewBag.KhoaId">@i</a>
                </li>
            }
            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(page + 1)" asp-route-search="@ViewBag.Search" asp-route-khoaId="@ViewBag.KhoaId">»</a>
            </li>
        </ul>
    </nav>
}
